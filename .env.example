# Autograff Content Studio: example environment.
# Names and SAFE PLACEHOLDERS ONLY. Never put real values in this file.
# Copy to .env.local for local development (gitignored). Preview and production
# values live in Vercel's per-environment settings, never in the repository.
# Only variables prefixed NEXT_PUBLIC_ reach the browser; keep that list to the
# three below.

# --- Application -------------------------------------------------------------
# Local: http://localhost:3000 · Preview: set per deployment · Production: https://studio.autograff.ai
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=local                      # local | preview | production

# --- Supabase (Studio's OWN projects; never the autograff-site pipeline project)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
SUPABASE_SECRET_KEY=sb_secret_placeholder          # server-only: job runner, invites
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres   # migrations/tests only
AUTH_REDIRECT_PATH=/auth/callback

# --- Background jobs ---------------------------------------------------------
CRON_SECRET=replace-with-random-string             # required by /api/jobs/tick

# --- AI provider -------------------------------------------------------------
LLM_PROVIDER=fake                  # fake | anthropic
ANTHROPIC_API_KEY=                 # empty locally => use fake provider
LLM_MODEL_DRAFT=claude-opus-5-5    # concepts and drafts (D-06b)
LLM_MODEL_EXTRACT=claude-sonnet-5-5  # checks and extraction
# Spend ceilings are NOT environment variables: they live in the database
# (settings.ai_monthly_budget_usd, default 10, capped at 50; per run default 2)
# so the app cannot raise them (D-21, D-28).

# --- Research provider -------------------------------------------------------
RESEARCH_PROVIDER=fake             # fake | anthropic (Claude web search, uses ANTHROPIC_API_KEY; D-06)

# --- Slack (Phase 6; leave empty until then) ---------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_PATH=/integrations/slack/callback

# --- LinkedIn (Phase 10; leave empty until access is verified) ---------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_PATH=/integrations/linkedin/callback
LINKEDIN_API_VERSION=              # YYYYMM, pinned; versions are sunset regularly
PUBLISHING_ENABLED=false           # kill switch for API publishing

# --- Email for auth (configured in Supabase Auth SMTP settings, not read by the app)
# SMTP host/user/password are entered in the Supabase dashboard per project.
